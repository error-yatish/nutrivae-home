---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Nutrivae Foods" currentPath="/contact">
<main>

        <section class="page-hero">
            <div class="page-hero-inner">
                <span class="section-tag" data-animate="fade-up">Talk to Us</span>
                <h1 data-animate="fade-up" data-delay="100">We'd love<br>to <em>connect.</em></h1>
                <p data-animate="fade-up" data-delay="200">Whether you have a question, partnership idea, or simply want
                    to know more about what we do; our team is here.</p>
            </div>
            <div class="page-hero-blob"></div>
        </section>

        <div class="contact-section">

            <!-- Info -->
            <div class="contact-info" data-animate="fade-up">
                <span class="section-tag">Contact Info</span>
                <h2>Let's start a <em>conversation.</em></h2>
                <p>We believe in building real relationships: with our farmers, our partners, and the people who eat
                    our food. Reach out and we'll respond promptly.</p>

                <div class="contact-item">
                    <div class="contact-item-icon">💬</div>
                    <div class="contact-item-text">
                        <h4>WhatsApp</h4>
                        <p>+91 98246-64973</p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-item-icon">📍</div>
                    <div class="contact-item-text">
                        <h4>Location</h4>
                        <p>India</p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-item-icon">⏰</div>
                    <div class="contact-item-text">
                        <h4>Response Time</h4>
                        <p>Within 24 business hours</p>
                    </div>
                </div>

                <div class="contact-socials">
                    <a href="https://www.instagram.com/nutrivae.official/?hl=en" target="_blank" class="contact-social-btn" id="ig-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <rect x="2" y="2" width="20" height="20" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                        </svg>
                        Instagram
                    </a>
                    <a href="https://www.facebook.com/profile.php?id=61588123586823" target="_blank" class="contact-social-btn" id="fb-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                        </svg>
                        Facebook
                    </a>
                </div>
            </div>

            <!-- Form -->
            <div class="contact-form-wrap" data-animate="fade-up" data-delay="150">
                <div id="contact-form-area">
                    <h3 class="form-title">Send a Message</h3>
                    <p class="form-subtitle">Fill in the form below and we'll get back to you shortly.</p>
                    <form id="contact-form" novalidate>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="first-name">First Name</label>
                                <input type="text" id="first-name" name="first-name" placeholder="Ravi" required>
                            </div>
                            <div class="form-group">
                                <label for="last-name">Last Name</label>
                                <input type="text" id="last-name" name="last-name" placeholder="Sharma" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" placeholder="ravi@example.com" required>
                        </div>
                        <div class="form-group">
                            <label for="subject">Subject</label>
                            <select id="subject" name="subject">
                                <option value="">Select a topic…</option>
                                <option value="product">Product Enquiry</option>
                                <option value="bulk">Bulk / Wholesale Order</option>
                                <option value="partnership">Partnership</option>
                                <option value="feedback">Feedback</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="message">Your Message</label>
                            <textarea id="message" name="message" placeholder="Tell us what's on your mind…"
                                required></textarea>
                        </div>
                        <button type="submit" class="form-submit" id="form-submit-btn">Send Message →</button>
                    </form>
                </div>
                <div class="form-success" id="form-success">
                    <div class="success-icon">🌱</div>
                    <h3>Message Sent!</h3>
                    <p>Thank you for reaching out. We'll get back to you within 24 hours.</p>
                </div>
            </div>

        </div>

    </main>
</Layout>
