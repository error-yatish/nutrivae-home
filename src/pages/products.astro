---
import Layout from "../layouts/Layout.astro";
import { getProducts } from '../services/api';

const allProducts = await getProducts();
---

<Layout title="Products | Nutrivae Foods" currentPath="/products">
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="section-tag" data-animate="fade-up">What We Make</span>
        <h1 data-animate="fade-up" data-delay="100">
          Simple foods,<br /><em>trusted nutrition.</em>
        </h1>
        <p data-animate="fade-up" data-delay="200">
          Thoughtfully processed, plant-based staples for every Indian
          household.
        </p>
      </div>
      <div class="page-hero-blob"></div>
    </section>

    <!-- Products Layout -->
    <div class="products-layout">
      <!-- Filter Sidebar -->
      <aside class="filter-sidebar" data-lenis-prevent>
        <div class="filter-group">
          <h4>Categories</h4>
          <button class="filter-btn active" data-filter="all"
            >All Products</button
          >
          <button class="filter-btn" data-filter="daal">Daals</button>
          <button class="filter-btn" data-filter="grains">Grains</button>
          <button class="filter-btn" data-filter="seeds">Seeds</button>
          <button class="filter-btn" data-filter="nuts">Nuts</button>
          <button class="filter-btn" data-filter="flour">Flours</button>
          <button class="filter-btn" data-filter="spices">Spices</button>
        </div>
        <div class="filter-group">
          <h4>Size</h4>
          <div class="filter-list">
            <label><input type="checkbox" checked /> 500g</label>
            <label><input type="checkbox" checked /> 1kg</label>
            <label><input type="checkbox" checked /> 5kg</label>
          </div>
        </div>
        <div class="filter-group">
          <h4>Price Range</h4>
          <div class="filter-list">
            <label><input type="checkbox" checked /> Under ₹100</label>
            <label><input type="checkbox" checked /> ₹100 - ₹300</label>
            <label><input type="checkbox" checked /> Above ₹300</label>
          </div>
        </div>
        <div class="filter-group">
          <h4>Farm Source</h4>
          <div class="filter-list">
            <label><input type="checkbox" checked /> Gujarat</label>
            <label><input type="checkbox" checked /> Maharashtra</label>
            <label><input type="checkbox" checked /> Rajasthan</label>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <div class="products-main">
        <div class="products-search-bar">
          <input
            type="text"
            id="productSearch"
            placeholder="Search products..."
          />
        </div>

        <!-- Products Grid -->
        <div class="full-grid" id="products-grid">
          {
            allProducts.map((p, i) => (
              <div
                class="prod-item"
                data-animate="fade-up"
                data-delay={(i % 4) * 100}
                data-category={p.data.category}
              >
                <div class="prod-img">
                  <div class="prod-badge-row">
                    {p.data.isNew && <span class="prod-label green">New</span>}
                  </div>
                  <a href={`/product/${p.data.id}`}>
                    <img src={p.data.image} alt={p.data.name} style="transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'"/>
                  </a>
                </div>
                <div class="prod-info">
                  <h3><a href={`/product/${p.data.id}`} style="color: inherit; text-decoration: none;">{p.data.name}</a></h3>
                  <p class="prod-sub">{p.data.subtitle}</p>
                  <div class="prod-specs">
                    {p.data.specs.map((s) => (
                      <span class="spec-tag">{s}</span>
                    ))}
                  </div>
                  <div class="prod-foot">
                    <div class="prod-foot-actions">
                      <a
                        href={p.data.whatsappLink}
                        target="_blank"
                        class="prod-cta-btn"
                        style="text-decoration:none;"
                      >
                        Buy via WhatsApp ↗
                      </a>
                      {p.data.journey && (
                        <button
                          class="btn-journey"
                          data-journey="true"
                          data-product={p.data.name}
                          data-farmer={p.data.journey.farmer}
                          data-location={p.data.journey.location}
                          data-times={p.data.journey.times}
                          data-images={p.data.journey.images}
                        >
                          View Journey
                        </button>
                      )}
                    </div>
                    {p.data.nutrition && (
                      <span class="prod-nutrition">{p.data.nutrition}</span>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Pagination -->
        <div class="pagination" id="pagination-controls">
          <!-- JS generated -->
        </div>
      </div>
    </div>

    <!-- Promise Strip -->
    <div class="promise-strip" data-animate="fade-up">
      <div class="promise-inner">
        <div class="promise-item">
          <div class="p-icon">🌾</div>
          <h4>Farm Sourced</h4>
          <p>Directly from responsible Indian farmers</p>
        </div>
        <div class="promise-item">
          <div class="p-icon">🚫</div>
          <h4>No Preservatives</h4>
          <p>Clean label, nothing artificial</p>
        </div>
        <div class="promise-item">
          <div class="p-icon">💚</div>
          <h4>100% Vegetarian</h4>
          <p>Pure plant-based ingredients</p>
        </div>
        <div class="promise-item">
          <div class="p-icon">🛡</div>
          <h4>Quality Assured</h4>
          <p>Consistent nutrition, every batch</p>
        </div>
      </div>
    </div>

    <section class="cta-banner">
      <div class="cta-banner-inner">
        <div class="cta-banner-text">
          <span class="section-tag light">More Coming Soon</span>
          <h2>Growing our <em>range.</em></h2>
          <p>
            New clean-label products are in development. Contact us to stay in
            the loop or for bulk enquiries.
          </p>
          <a href="contact.html" class="btn-primary light">Get in Touch</a>
        </div>
        <div class="cta-banner-img">
          <img src="assets/ingredients_flat.png" alt="Nutrivae range" />
        </div>
      </div>
    </section>

    <!-- Journey Modal -->
    <div class="journey-modal-overlay" id="journey-modal">
      <div class="journey-modal-content">
        <button class="journey-modal-close" id="journey-modal-close"
          >&times;</button
        >
        <div class="journey-modal-body" data-lenis-prevent>
          <div class="journey-header">
            <span class="section-tag">Product Journey</span>
            <h2 id="journey-title">Product Name</h2>
            <p class="journey-meta">
              Farmer: <strong id="journey-farmer"></strong> &nbsp;&bull;&nbsp; Location:
              <a
                id="journey-location-link"
                href="#"
                target="_blank"
                style="color: var(--green); text-decoration: underline;"
                ><strong id="journey-location"></strong></a
              >
            </p>
          </div>
          <div class="timeline-container" id="journey-timeline">
            <div class="timeline-line"></div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Soil Preparation <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Rich, nutrient-dense soil prepared using natural methods.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Planting <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Sourced heirloom seeds planted with care and intention.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Harvesting <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>
                  Hand-picked at peak ripeness to ensure maximum flavor and
                  nutrition.
                </p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Processing <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Cleaned and naturally processed without harsh chemicals.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Packaging <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Sealed fresh in eco-conscious packaging for your pantry.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lightbox -->
    <div id="lightbox-overlay">
      <img id="lightbox-img" src="" alt="Expanded View" />
    </div>
  </main>
  <script is:inline>
                    (function () {
                      console.log("Init filter & pagination for products");
                      const filterBtns = document.querySelectorAll(".filter-btn");
                      const products = document.querySelectorAll(".prod-item");
                      const paginationContainer = document.querySelector(".pagination");
                      const searchInput = document.getElementById("productSearch");

                      let currentFilter = "all";
                      let currentSearch = "";
                      let currentPage = 1;
                      const itemsPerPage = 12;
                      let filteredItems = Array.from(products);

                      if (!paginationContainer) {
                        console.error("Missing paginationContainer");
                        return;
                      }

                      function renderPagination() {
                        const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
                        paginationContainer.innerHTML = "";

                        if (totalPages <= 1) return;

                        for (let i = 1; i <= totalPages; i++) {
                          const btn = document.createElement("button");
                          btn.className = "page-btn" + (i === currentPage ? " active" : "");
                          btn.textContent = i;
                          btn.style.margin = "0 5px";
                          btn.addEventListener("click", () => {
                            currentPage = i;
                            updateView();
                            const grid = document.querySelector(".full-grid");
                            if (grid) {
                              const offset = grid.getBoundingClientRect().top + window.scrollY - 150;
                              window.scrollTo({ top: offset, behavior: "smooth" });
                            }
                          });
                          paginationContainer.appendChild(btn);
                        }
                      }

                      function updateView() {
                        // Hide all products first
                        products.forEach((p) => {
                          p.style.display = "none";
                        });

                        const start = (currentPage - 1) * itemsPerPage;
                        const end = start + itemsPerPage;

                        // Show only paginated items
                        filteredItems.slice(start, end).forEach((p) => {
                          p.style.display = "block";
                          p.style.opacity = "1";
                          p.style.transform = "none";
                          p.style.animation = "none";
                          p.offsetHeight; // force reflow
                          p.classList.add('animated');
                        });

                        renderPagination();
                      }

                      function applyFilters() {
                        filteredItems = Array.from(products).filter((p) => {
                          const cat = p.getAttribute("data-category") || "";
                          const name = (p.querySelector("h3")?.textContent || "").toLowerCase();
                          
                          const matchesCat = currentFilter === "all" || cat.includes(currentFilter);
                          const matchesSearch = currentSearch === "" || name.includes(currentSearch);
                          
                          return matchesCat && matchesSearch;
                        });
                        currentPage = 1;
                        updateView();
                      }

                      filterBtns.forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                          e.preventDefault();
                          filterBtns.forEach((b) => b.classList.remove("active"));
                          btn.classList.add("active");
                          currentFilter = btn.getAttribute("data-filter");
                          applyFilters();
                        });
                      });

                      if (searchInput) {
                        searchInput.addEventListener("input", (e) => {
                          currentSearch = e.target.value.toLowerCase();
                          applyFilters();
                        });
                      }

                      // Run immediately
                      applyFilters();
                    })();
                  
        // Journey Modal Functionality (Restored)
        (function() {
            const journeyModal = document.getElementById('journey-modal');
            const journeyClose = document.getElementById('journey-modal-close');
            
            const jTitle = document.getElementById('journey-title');
            const jFarmer = document.getElementById('journey-farmer');
            const jLocation = document.getElementById('journey-location');
            const jLocationLink = document.getElementById('journey-location-link');
            let timelineSteps = null;
            if(journeyModal) {
                timelineSteps = journeyModal.querySelectorAll('.timeline-step');
            }

            if(journeyModal && journeyClose) {
                // Use event delegation for dynamic buttons
                document.body.addEventListener('click', (e) => {
                    const btn = e.target.closest('.btn-journey');
                    if (!btn) return;
                    
                    const product = btn.getAttribute('data-product');
                    const farmer = btn.getAttribute('data-farmer');
                    const location = btn.getAttribute('data-location');
                    const timesStr = btn.getAttribute('data-times') || '';
                    const imagesStr = btn.getAttribute('data-images') || '';
                    
                    const times = timesStr.split('|');
                    const images = imagesStr.split('|');
                    
                    if (product && jTitle) jTitle.textContent = product + ' Journey';
                    if (farmer && jFarmer) jFarmer.textContent = farmer;
                    if (location && jLocation) {
                        jLocation.textContent = location;
                        if(jLocationLink) jLocationLink.href = 'https://maps.google.com/?q=' + encodeURIComponent(location);
                    }

                    // Update timeline steps dynamically
                    if(timelineSteps) {
                        timelineSteps.forEach((step, index) => {
                            const timeSpan = step.querySelector('.step-time');
                            const gallery = step.querySelector('.step-gallery');
                            
                            // Time is required (if available in array)
                            if (timeSpan) {
                                timeSpan.textContent = times[index] ? times[index].trim() : '';
                            }
                            
                            // Image is optional and can be multiple
                            if (gallery) {
                                gallery.innerHTML = ''; // Clear previous
                                if (images[index] && images[index].trim() !== '') {
                                    const stepImgs = images[index].split(',');
                                    stepImgs.forEach(imgSrc => {
                                        if (!imgSrc.trim()) return;
                                        const img = document.createElement('img');
                                        img.src = imgSrc.trim();
                                        // Responsive grid style for gallery items
                                        img.style.width = stepImgs.length > 1 ? 'calc(50% - 5px)' : '100%';
                                        img.style.maxHeight = '150px';
                                        img.style.objectFit = 'cover';
                                        img.style.borderRadius = '8px';
                                        img.style.cursor = 'zoom-in';
                                        img.style.transition = 'transform 0.3s';
                                        img.addEventListener('mouseover', () => img.style.transform = 'scale(1.02)');
                                        img.addEventListener('mouseout', () => img.style.transform = 'scale(1)');
                                        
                                        // Open Lightbox
                                        img.addEventListener('click', () => {
                                            const lbImg = document.getElementById('lightbox-img');
                                            const lbOverlay = document.getElementById('lightbox-overlay');
                                            if(lbImg && lbOverlay) {
                                                lbImg.src = img.src;
                                                lbOverlay.classList.add('active');
                                            }
                                        });
                                        gallery.appendChild(img);
                                    });
                                }
                            }
                        });
                    }

                    journeyModal.classList.add('active');
                    document.body.style.overflow = 'hidden'; // Prevent background scrolling
                });

                const lightboxOverlay = document.getElementById('lightbox-overlay');
                if (lightboxOverlay) {
                    lightboxOverlay.addEventListener('click', () => {
                        lightboxOverlay.classList.remove('active');
                    });
                }

                journeyClose.addEventListener('click', () => {
                    journeyModal.classList.remove('active');
                    document.body.style.overflow = '';
                });

                journeyModal.addEventListener('click', (e) => {
                    if (e.target === journeyModal) {
                        journeyModal.classList.remove('active');
                        document.body.style.overflow = '';
                    }
                });
            }
        })();
</script>
</Layout>
