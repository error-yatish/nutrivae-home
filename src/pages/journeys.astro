                      >Planting</span
                    >
                  </div>
                  <div class="jr-availability">
                    <span class="next-harvest" style="color: #6b8e23;"
                      >Next Harvest: Dec 2026</span
                    >
                  </div>
                  <div class="jr-action">
                    <button
                      class="btn-journey"
                      data-journey="true"
                      data-product="Mungfali"
                      data-farmer="Karsan Bhai"
                      data-location="Saurashtra, India"
                      data-times="May 2026|Current|Pending|Pending|Pending"
                      data-images="|assets/farm_field.png|||"
                      >View Journey</button
                    >
                  </div>
                </div>
              </div>

              <!-- Pagination -->
              <div class="pagination" id="pagination-controls">
                <!-- JS generated -->
              </div>
            </div>

            <!-- Journey Modal -->
            <div class="journey-modal-overlay" id="journey-modal">
              <div class="journey-modal-content">
                <button class="journey-modal-close" id="journey-modal-close"
                  >&times;</button
                >
                <div class="journey-modal-body" data-lenis-prevent>
                  <div class="journey-header">
                    <span class="section-tag">Product Journey</span>
                    <h2 id="journey-title">Product Name</h2>
                    <p class="journey-meta">
                      Farmer: <strong id="journey-farmer"></strong> &nbsp;&bull;&nbsp;
                      Location: <a
                        id="journey-location-link"
                        href="#"
                        target="_blank"
                        style="color: var(--green); text-decoration: underline;"
                        ><strong id="journey-location"></strong></a>
                    </p>
                  </div>
                  <div class="timeline-container" id="journey-timeline">
                    <div class="timeline-line"></div>
                    <div class="timeline-step">
                      <div class="timeline-dot"></div>
                      <div class="timeline-content">
                        <h4>
                          Soil Preparation <span
                            class="step-time"
                            style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                          ></span>
                        </h4>
                        <p>
                          Rich, nutrient-dense soil prepared using natural
