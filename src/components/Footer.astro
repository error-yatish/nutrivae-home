---
import { FEATURES } from '../config';
---
<footer>
    <div class="footer-top">
        <div class="footer-brand">
            <img src="/assets/logo.svg" alt="Nutrivae" class="footer-logo">
            <p>Thoughtfully Grown, Carefully Crafted. Clean, plant-based foods made with care, consistency, and
                integrity.
            </p>
            <div class="footer-socials">
                <a href="https://www.instagram.com/nutrivae.official/?hl=en" target="_blank" aria-label="Instagram" id="social-ig">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <rect x="2" y="2" width="20" height="20" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                    </svg>
                </a>
                <a href="https://www.facebook.com/profile.php?id=61588123586823" target="_blank" aria-label="Facebook" id="social-fb">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                    </svg>
                </a>
            </div>
        </div>
        <div class="footer-links-group">
            <h4>Company</h4>
            <a href="/about">Our Story</a>
            <a href="/products">Products</a>
            {FEATURES.enableFarmOrigins && <a href="/farm-origins">Farm Origins</a>}
            <a href="/contact">Contact Us</a>
        </div>
        <div class="footer-links-group">
            <h4>Products</h4>
            <a href="/products">Toor Daal</a>
            <a href="/products">Moong Daal</a>
            <a href="/products">Mungfali</a>
        </div>
        <div class="footer-links-group">
            <h4>Contact</h4>
            <a href="https://wa.me/919824664973?text=Hi,%20I%20need%20help%20with%20nutrivae%20products" target="_blank" style="text-decoration:none;">+91 98246-64973 ↗</a>
            <span>India</span>
        </div>
        <div class="footer-links-group">
            <h4>Legal</h4>
            <a href="/shipping">Shipping Info</a>
            <a href="/returns">Return Policy</a>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms & Conditions</a>
        </div>
    </div>
    <div class="footer-bottom">
        <span>&copy; 2026 Nutrivae Foods. All rights reserved.</span>
        <span>Thoughtfully Grown, Carefully Crafted.</span>
    </div>
</footer>
