                <p>Sealed fresh in eco-conscious packaging for your pantry.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
          </div>
                    >
                  </div>
                  <div class="jr-availability">
                    <span class="next-harvest" style="color: #8b6e4e;"
