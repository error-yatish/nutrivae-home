---
import Layout from '../layouts/Layout.astro';
import { getBlogs, getProducts, getJourneys } from '../services/api';

const allPosts = await getBlogs();
const allProducts = await getProducts();
---

<Layout title="Nutrivae Foods | Thoughtfully Grown, Carefully Crafted." currentPath="/">
<div class="page-loader" id="page-loader">
        <div class="loader-logo">
            <img src="assets/logo.svg" alt="Nutrivae">
        </div>
        <div class="loader-bar-wrap">
            <div class="loader-bar" id="loader-bar"></div>
        </div>
        <span class="loader-label" id="loader-label">0%</span>
    </div>

    <!-- Custom cursor -->
    <div class="cursor" id="cursor"></div>
    <div class="cursor-follower" id="cursor-follower">
        <svg width="32" height="32" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <mask id="leaf-mask">
                    <rect width="24" height="24" fill="white" />
                    <path d="M 12.5,15 C 15,11 18,8 21,7" fill="none" stroke="black" stroke-width="0.8"
                        stroke-linecap="round" />
                    <path d="M 10.5,14.5 C 8,12 5.5,10 4,9" fill="none" stroke="black" stroke-width="0.6"
                        stroke-linecap="round" />
                </mask>
            </defs>
            <g mask="url(#leaf-mask)">
                <path d="M 12,17 C 12,8 18,2 23,2 C 23,12 16,17 12,17 Z" fill="#88b04b" />
                <path d="M 11.5,16 C 10,10 6,5 2,6 C 2,13 8,16 11.5,16 Z" fill="#88b04b" />
                <path d="M 11,22 C 11.2,20 11.8,18 12,17" fill="none" stroke="#88b04b" stroke-width="1.5"
                    stroke-linecap="round" />
            </g>
        </svg>
    </div>

    <main>

        <!-- ===================== HERO COVER ===================== -->
        <section class="hero-section" id="hero">
            <div class="hero-bg"><img src="assets/hero_lifestyles.png" alt="Hero background"></div>
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <div class="intro-text">
                    <h1 id="hero-title">
                        <span class="hero-title"><span class="word-mask"><span class="word-inner"
                                    style="translate: none; rotate: none; scale: none; transform: translate(0px, 0px);">Everyday</span></span>
                            <span class="word-mask"><span class="word-inner"
                                    style="translate: none; rotate: none; scale: none; transform: translate(0px, 0px);">food,</span></span></span>
                        <span class="hero-title"><em class="highlight-word"><span class="word-mask"><span
                                        class="word-inner"
                                        style="translate: none; rotate: none; scale: none; transform: translate(0px, 0px);">honestly</span></span><svg
                                    class="underline-svg" viewBox="0 0 220 14" fill="none"
                                    xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path class="underline-path" d="M3,9 C50,3 120,13 218,7" stroke="#c8a84b"
                                        stroke-width="3.5" stroke-linecap="round" style="stroke-dashoffset: 0px;">
                                    </path>
                                </svg></em> <span class="word-mask"><span class="word-inner"
                                    style="translate: none; rotate: none; scale: none; transform: translate(0px, 0px);">nourishing.</span></span></span>
                    </h1>
                    <p class="hero-subtitle">Rooted in agriculture, guided by nutrition science.</p>
                    <div class="hero-btns" id="hero-btns" data-animate="fade-up" data-delay="200"
                        style="translate: none; rotate: none; scale: none; transform: translate(0px, 0px); opacity: 1;">
                        <a href="/products" class="btn-primary magnetic" id="hero-explore">Explore Products</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===================== PHILOSOPHY ===================== -->
        <section class="philosophy" id="philosophy">
            <div class="philosophy-header" data-animate="fade-up">
                <span class="section-tag">Our Philosophy</span>
                <h2>Nutrition doesn't need<br>to be <em>complicated.</em></h2>
            </div>
            <div class="philosophy-grid">
                <div class="phil-card" data-animate="fade-up" data-delay="0">
                    <div class="phil-number">01</div>
                    <div class="phil-icon">🌾</div>
                    <h3>Farm Rooted</h3>
                    <p>We work directly with farmers who share our commitment to sustainable, responsible agriculture.
                        Every ingredient has a story.</p>
                </div>
                <div class="phil-card" data-animate="fade-up" data-delay="100">
                    <div class="phil-number">02</div>
                    <div class="phil-icon">✦</div>
                    <h3>Purely Processed</h3>
                    <p>Modern facilities designed to preserve natural goodness. Minimal intervention, maximum nutrition
                        the way nature intended.</p>
                </div>
                <div class="phil-card" data-animate="fade-up" data-delay="200">
                    <div class="phil-number">03</div>
                    <div class="phil-icon">🛡</div>
                    <h3>Simply Trusted</h3>
                    <p>Pure, accessible, and trustworthy. Nutrivae brings traditional food values into modern lifestyles
                        without compromise.</p>
                </div>
            </div>
        </section>

        <!-- ===================== STORYTELLING ===================== -->
        <!-- ===================== STORYTELLING (SVG TIMELINE) ===================== -->
        <section class="timeline-section" id="timeline-section">
            <!-- SVG Path spanning the section -->
            <div class="timeline-svg-wrapper">
                <svg viewBox="0 0 100 1000" preserveAspectRatio="none" width="100%" height="100%">
                    <defs>
                        <!-- The soft tapered brush gradient for the drawing edge -->
                        <linearGradient id="draw-gradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="white" />
                            <stop offset="70%" stop-color="white" />
                            <stop offset="100%" stop-color="transparent" />
                        </linearGradient>
                        <mask id="draw-mask">
                            <!-- GSAP will animate the height of this rect from 0 to 1000 -->
                            <rect id="draw-mask-rect" x="0" y="0" width="100" height="0" fill="url(#draw-gradient)" />
                        </mask>
                    </defs>

                    <!-- Faint background waves (always visible) -->
                    <g class="waves-bg">
                        <path class="wave-path" d="M 30 0 C 80 150, -20 350, 70 500 C 120 650, -10 850, 40 950" />
                        <path class="wave-path" d="M 70 0 C -10 200, 110 400, 30 600 C -30 800, 90 950, 70 1000" />
                        <path class="wave-path" d="M 50 0 C 30 250, 70 450, 50 700 C 30 800, 80 850, 60 880" />
                    </g>

                    <!-- Glowing foreground waves (revealed by the moving mask) -->
                    <g class="waves-fg" mask="url(#draw-mask)">
                        <path class="wave-path fg-1" d="M 30 0 C 80 150, -20 350, 70 500 C 120 650, -10 850, 40 950" />
                        <path class="wave-path fg-2" d="M 70 0 C -10 200, 110 400, 30 600 C -30 800, 90 950, 70 1000" />
                        <path class="wave-path fg-3" d="M 50 0 C 30 250, 70 450, 50 700 C 30 800, 80 850, 60 880" />
                    </g>
                </svg>
            </div>

            <!-- Content items -->
            <div class="timeline-container">

                <!-- Item 1 -->
                <div class="timeline-item">
                    <div class="tl-content tl-text" data-animate="fade-up">
                        <span class="section-tag">From Farm</span>
                        <h2>Sourced with<br><em>intention.</em></h2>
                        <p>We partner with farmers across India who grow using responsible practices. Every seed, every
                            harvest is chosen with care for quality and the earth.</p>
                    </div>
                    <div class="tl-node">
                        <div class="tl-dot"></div>
                    </div>
                    <div class="tl-content tl-img" data-animate="fade-up" data-delay="100">
                        <img src="assets/farm_field.png" alt="Farm fields">
                    </div>
                </div>

                <!-- Item 2 -->
                <div class="timeline-item item-reverse">
                    <div class="tl-content tl-text" data-animate="fade-up">
                        <span class="section-tag">To Factory</span>
                        <h2>Crafted with<br><em>precision.</em></h2>
                        <p>Our modern processing ensures the natural goodness of every grain is preserved. No artificial
                            additives. No shortcuts. Just clean, honest food.</p>
                    </div>
                    <div class="tl-node">
                        <div class="tl-dot"></div>
                    </div>
                    <div class="tl-content tl-img" data-animate="fade-up" data-delay="100">
                        <img src="assets/ingredients_flat.png" alt="Processing">
                    </div>
                </div>

                <!-- Item 3 -->
                <div class="timeline-item">
                    <div class="tl-content tl-text" data-animate="fade-up">
                        <span class="section-tag">To You</span>
                        <h2>Delivered with<br><em>trust.</em></h2>
                        <p>From our hands to your table, Nutrivae promises simple nutrition you can rely on. Every pack,
                            every time consistently wholesome.</p>
                    </div>
                    <div class="tl-node">
                        <div class="tl-dot"></div>
                    </div>
                    <div class="tl-content tl-img" data-animate="fade-up" data-delay="100">
                        <img src="assets/hero_lifestyles.png" alt="Delivered to you">
                    </div>
                </div>

            </div>
        </section>

        <!-- ===================== PRODUCTS ===================== -->
        <section class="products-section" id="products">
            <div class="products-header" data-animate="fade-up" style="text-align: center; display: block;">
                <span class="section-tag" style="margin: 0 auto;">What We Make</span>
                <h2 style="margin-top: 15px;">Simple foods,<br><em>trusted nutrition.</em></h2>
            </div>

            
<div class="full-grid">
              {
                allProducts.slice(0, 4).map((p, i) => (
                  <div
                    class="prod-item animated"
                    data-animate="fade-up"
                    data-delay={(i % 4) * 100}
                    data-category={p.data.category}
                    data-price={p.data.price}
                    style="min-width: 280px; max-width: 300px; flex-shrink: 0;"
                  >
                    <div class="prod-img">
                      <div class="prod-badge-row">
                        {p.data.isNew ? <span class="prod-label green">Bestseller</span> : null}
                      </div>
                      <a href={`/product/${p.data.id}`}>
                        <img
                          src={p.data.image}
                          alt={p.data.name}
                        />
                      </a>
                    </div>
                    <div class="prod-info" style="padding: 15px; display: flex; flex-direction: column; flex-grow: 1;">
                      <div style="flex-grow: 1;">
                        <h3 style="margin: 0 0 5px 0; font-size: 0.95rem; font-weight: 600; line-height: 1.3;">
                          <a href={`/product/${p.data.id}`} style="color: #333; text-decoration: none;">
                            {p.data.name}
                          </a>
                        </h3>
                        <p class="prod-sub" style="margin: 0 0 10px 0; color: #888; font-size: 0.8rem;">{p.data.subtitle || "1 Unit"}</p>
                        
                        <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 12px; font-size: 0.8rem;">
                          <span style="color: #00875A;">★★★★☆</span>
                          <span style="color: #00875A; font-weight: 600;">4.{Math.floor(Math.random() * 5) + 1}</span>
                          <span style="color: #888;">({Math.floor(Math.random() * 500) + 50})</span>
                        </div>
                      </div>
                      
                      <div class="prod-price-action" style="margin-top: auto;">
                        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 15px;">
                          <span style="font-weight: 700; font-size: 1.1rem; color: #333;">₹{p.data.price}</span>
                          <span style="text-decoration: line-through; color: #888; font-size: 0.85rem;">₹{Math.floor(p.data.price * 1.25)}</span>
                          <span style="color: #00875A; font-size: 0.8rem; font-weight: 600;">22% off</span>
                        </div>
                        
                        <div class="cart-control-container" data-product-id={p.data.id} data-product-json={JSON.stringify(p.data)}>
                          <button class="add-init-btn">
                            ADD
                          </button>
                          <div class="qty-control">
                            <button class="qty-dec-btn qty-btn">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                            <span class="qty-val">1</span>
                            <button class="qty-inc-btn qty-btn" style="font-size: 1.2rem; line-height: 1;">+</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="view-all-container" data-animate="fade-up" style="text-align: center; margin-top: 4rem;">
                <a href="/products" class="btn-primary" style="font-size: 1.1rem; padding: 1rem 3rem;">View All
                    Products</a>
            </div>
        </section>

        <!-- ===================== STATS BAND ===================== -->
        <section class="stats-band" data-animate="fade-up">
            <div class="stat-item">
                <div class="stat-number" data-count="100">0</div>
                <div class="stat-label">% Plant-Based</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <div class="stat-number" data-count="0">0</div>
                <div class="stat-label">Preservatives Added</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <div class="stat-number" data-count="3">0</div>
                <div class="stat-label">Products & Growing</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <div class="stat-number" data-count="100">0</div>
                <div class="stat-label">% Honest Ingredients</div>
            </div>
        </section>

        <!-- ===================== CUSTOMER REVIEWS ===================== -->
        <section class="reviews-section" id="reviews">
            <div class="reviews-header" data-animate="fade-up">
                <span class="section-tag">Loved by Many</span>
                <h2>What our <em>customers say</em></h2>
            </div>

            <div class="reviews-grid">
                <!-- Review 1 -->
                <div class="review-card" data-animate="fade-up" data-delay="0">
                    <div class="review-stars">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                    </div>
                    <blockquote class="review-text">"The quality of their lentils and spice blends is genuinely
                        unmatched. It’s rare to find a brand that takes ethical sourcing this seriously. Truly a staple
                        in my pantry now."</blockquote>
                    <div class="review-author">
                        <div class="author-avatar">P</div>
                        <div class="author-info">
                            <strong>Priya M.</strong>
                            <span>Verified Buyer</span>
                        </div>
                    </div>
                </div>

                <!-- Review 2 -->
                <div class="review-card" data-animate="fade-up" data-delay="100">
                    <div class="review-stars">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                    </div>
                    <blockquote class="review-text">"I’ve tried many plant-based brands, but Nutrivae stands out. The
                        flavors are authentic and knowing there are zero preservatives or fillers gives me absolute
                        peace of mind."</blockquote>
                    <div class="review-author">
                        <div class="author-avatar">A</div>
                        <div class="author-info">
                            <strong>Arjun R.</strong>
                            <span>Verified Buyer</span>
                        </div>
                    </div>
                </div>

                <!-- Review 3 -->
                <div class="review-card" data-animate="fade-up" data-delay="200">
                    <div class="review-stars">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent)">
                            <path
                                d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" />
                        </svg>
                    </div>
                    <blockquote class="review-text">"Their entire range of grains and snacks is incredibly fresh. You
                        can genuinely taste the difference when food is minimally processed. I highly recommend them to
                        everyone."</blockquote>
                    <div class="review-author">
                        <div class="author-avatar">S</div>
                        <div class="author-info">
                            <strong>Sarah K.</strong>
                            <span>Verified Buyer</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Blog Preview Section -->
        <section class="blog-preview" id="blog-preview">
            <h2 class="section-title">From Our Blog</h2>
            <div class="blog-grid">
                {allPosts.slice(0, 3).map((post, index) => (
                    <article class="blog-card" data-animate="fade-up" data-delay={index * 100}>
                        <img src={post.data.image} alt={post.data.title} />
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                        <a href={`/blog/${post.slug}`} class="btn-text-link">Read more →</a>
                    </article>
                ))}
            </div>
        </section>

        <!-- ===================== FAQ SECTION ===================== -->
        <section class="faq-section" id="faq">
            <div class="faq-header" data-animate="fade-up">
                <span class="section-tag">Got Questions?</span>
                <h2>Frequently Asked <em>Questions</em></h2>
            </div>

            <div class="faq-accordion" data-animate="fade-up" data-delay="100">
                <!-- FAQ Item 1 -->
                <div class="faq-item">
                    <button class="faq-question">
                        Are all Nutrivae products 100% plant-based?
                        <span class="faq-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>Yes, absolutely. Our entire diverse range of grains, lentils, spice blends, and healthy
                                snacks is 100% vegetarian and plant-based, sourced directly from trusted farming
                                partners.</p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Item 2 -->
                <div class="faq-item">
                    <button class="faq-question">
                        Do you use any preservatives or artificial additives?
                        <span class="faq-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>No. We believe in keeping food as close to its natural state as possible. None of our
                                products contain artificial preservatives, artificial colors, synthetic flavors, or
                                unnecessary fillers.</p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Item 3 -->
                <div class="faq-item">
                    <button class="faq-question">
                        Where do you source your ingredients?
                        <span class="faq-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </span>
                    </button>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p>We work directly with a network of ethical, sustainable farmers across prime agricultural
                                regions. This ensures we get the highest quality, freshest crops while directly
                                supporting local farming communities.</p>
                        </div>
                    </div>
