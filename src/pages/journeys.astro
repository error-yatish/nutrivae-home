---
import Layout from "../layouts/Layout.astro";
import { getJourneys } from '../services/api';

const allJourneys = await getJourneys();
---

<Layout title="Journeys | Nutrivae Foods" currentPath="/journeys">
  <main>
    <div class="page-header-minimal">
      <h1>Farm Journeys</h1>
      <p>Track the journey of your food from farm to table.</p>
    </div>

    <!-- Filter bar -->
    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">All Farms</button>
      <button class="filter-btn" data-filter="soil">Soil Preparation</button>
      <button class="filter-btn" data-filter="planting">Planting</button>
      <button class="filter-btn" data-filter="harvesting">Harvesting</button>
      <button class="filter-btn" data-filter="ready">Ready for Sale</button>
    </div>

    <!-- Search Bar -->
    <div class="products-search-bar" style="margin-top: 2rem;">
      <input
        type="text"
        id="journeySearch"
        placeholder="Search by product, farmer, or location..."
      />
    </div>

    <!-- Journey List -->
    <section class="journey-list-container">
      <div
        class="category-header"
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;"
      >
        <h2
          id="currentCategoryLabel"
          style="font-size: 1.5rem; font-style: italic;"
        >
          All Farms
        </h2>
      </div>
      <div class="journey-list" id="products-grid">
        {
          allJourneys.map((j) => (
            <div class="journey-row" data-category={j.data.category}>
              <div class="jr-image">
                <img src={j.data.image} alt={j.data.name} />
              </div>
              <div class="jr-info">
                <h3>{j.data.name}</h3>
                <p>
                  {j.data.location} &bull; Farmer: {j.data.farmer}
                </p>
              </div>
              <div class="jr-status">
                <span
                  class="status-badge"
                  style="background: rgba(136, 176, 75, 0.15); color: var(--green);"
                >
                  {j.data.status}
                </span>
              </div>
              <div class="jr-availability">
                {j.data.nextHarvest && (
                  <span class="next-harvest" style="color: var(--accent);">
                    Next Harvest: {j.data.nextHarvest}
                  </span>
                )}
                {j.data.whatsappLink && (
                  <a href={j.data.whatsappLink} target="_blank" class="buy-btn">
                    Buy via WhatsApp ↗
                  </a>
                )}
              </div>
              <div class="jr-action">
                {j.data.journey && (
                  <button
                    class="btn-journey"
                    data-journey="true"
                    data-product={j.data.name}
                    data-farmer={j.data.farmer}
                    data-location={j.data.location}
                    data-times={j.data.journey.times}
                    data-images={j.data.journey.images}
                  >
                    View Journey
                  </button>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Pagination -->
      <div class="pagination" id="pagination-controls">
        <!-- JS generated -->
      </div>
    </section>

    <!-- Journey Modal -->
    <div class="journey-modal-overlay" id="journey-modal">
      <div class="journey-modal-content">
        <button class="journey-modal-close" id="journey-modal-close"
          >&times;</button
        >
        <div class="journey-modal-body" data-lenis-prevent>
          <div class="journey-header">
            <span class="section-tag">Product Journey</span>
            <h2 id="journey-title">Product Name</h2>
            <p class="journey-meta">
              Farmer: <strong id="journey-farmer"></strong> &nbsp;&bull;&nbsp; Location:
              <a
                id="journey-location-link"
                href="#"
                target="_blank"
                style="color: var(--green); text-decoration: underline;"
                ><strong id="journey-location"></strong></a>
            </p>
          </div>
          <div class="timeline-container" id="journey-timeline">
            <div class="timeline-line"></div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Soil Preparation <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Rich, nutrient-dense soil prepared using natural methods.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Planting <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Sourced heirloom seeds planted with care and intention.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Harvesting <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>
                  Hand-picked at peak ripeness to ensure maximum flavor and
                  nutrition.
                </p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Processing <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Cleaned and naturally processed without harsh chemicals.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Packaging <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Sealed fresh in eco-conscious packaging for your pantry.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
          </div>
                    >
                  </div>
                  <div class="jr-availability">
                    <span class="next-harvest" style="color: #8b6e4e;"
                      >Next Harvest: Feb 2027</span
                    >
                  </div>
                  <div class="jr-action">
                    <button
                      class="btn-journey"
                      data-journey="true"
                      data-product="Toor Daal"
                      data-farmer="Vikram Rao"
                      data-location="Maharashtra, India"
                      data-times="Current|Pending|Pending|Pending|Pending"
                      data-images="assets/farm_field.png||||"
                      >View Journey</button
                    >
                  </div>
                </div>

                <!-- Farm 4: Planting -->
                <div class="journey-row" data-category="planting">
                  <div class="jr-image">
                    <img src="assets/mungfali.png" alt="Mungfali" />
                  </div>
                  <div class="jr-info">
                    <h3>Mungfali (Peanuts)</h3>
                    <p>Saurashtra Farm &bull; Farmer: Karsan Bhai</p>
                  </div>
                  <div class="jr-status">
                    <span
                      class="status-badge"
