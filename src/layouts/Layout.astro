---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import '../../public/styles.css';

interface Props {
	title: string;
    description?: string;
    currentPath: string;
}

const { title, description = "Nutrivae focuses on clean, plant-based foods made with care, consistency, and integrity. Pure, accessible, and trustworthy nutrition for everyday life.", currentPath } = Astro.props;
const PUBLIC_STRAPI_URL = (typeof globalThis !== 'undefined' && (globalThis as any).process?.env?.PUBLIC_STRAPI_URL) || import.meta.env.PUBLIC_STRAPI_URL || 'http://127.0.0.1:1337';
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;0,700;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <!-- Lenis smooth scroll -->
    <script is:inline src="https://unpkg.com/lenis@1.1.14/dist/lenis.min.js"></script>
    <script is:inline define:vars={{ PUBLIC_STRAPI_URL }}>
        window.STRAPI_URL = PUBLIC_STRAPI_URL;
    </script>
</head>

<body class={currentPath === '/' ? "home" : ""}>
    
    <!-- Custom cursor -->
    <div class="cursor" id="cursor"></div>
    <div class="cursor-follower" id="cursor-follower">
        <svg width="32" height="32" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <mask id="leaf-mask">
                    <rect width="24" height="24" fill="white" />
                    <path d="M 12.5,15 C 15,11 18,8 21,7" fill="none" stroke="black" stroke-width="0.8"
                        stroke-linecap="round" />
                    <path d="M 10.5,14.5 C 8,12 5.5,10 4,9" fill="none" stroke="black" stroke-width="0.6"
                        stroke-linecap="round" />
                </mask>
            </defs>
            <g mask="url(#leaf-mask)">
                <path d="M 12,17 C 12,8 18,2 23,2 C 23,12 16,17 12,17 Z" fill="#88b04b" />
                <path d="M 11.5,16 C 10,10 6,5 2,6 C 2,13 8,16 11.5,16 Z" fill="#88b04b" />
                <path d="M 11,22 C 11.2,20 11.8,18 12,17" fill="none" stroke="#88b04b" stroke-width="1.5"
                    stroke-linecap="round" />
            </g>
        </svg>
    </div>

    <Header currentPath={currentPath} />

    <slot />

    <CartDrawer />
    <Footer />

    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script is:inline src="/script.js"></script>
    
    <script>
      import { addToCart, updateQuantity, removeFromCart, cartItems } from "../store/cartStore.js";

      document.addEventListener("DOMContentLoaded", () => {
        cartItems.subscribe((items) => {
          document.querySelectorAll(".cart-control-container").forEach(container => {
            const productId = container.getAttribute("data-product-id");
            const initBtn = container.querySelector(".add-init-btn");
            const qtyControl = container.querySelector(".qty-control");
            const qtyVal = container.querySelector(".qty-val");
            
            if (items[productId]) {
              initBtn.style.display = "none";
              qtyControl.style.display = "flex";
              qtyVal.textContent = items[productId].quantity;
            } else {
              initBtn.style.display = "block";
              qtyControl.style.display = "none";
            }
          });
        });

        document.body.addEventListener("click", (e) => {
          const initBtn = e.target.closest(".add-init-btn");
          if (initBtn) {
            const container = initBtn.closest(".cart-control-container");
            const product = JSON.parse(container.getAttribute("data-product-json"));
            addToCart(product);
            return;
          }

          const incBtn = e.target.closest(".qty-inc-btn");
          if (incBtn) {
            const container = incBtn.closest(".cart-control-container");
            const productId = container.getAttribute("data-product-id");
            const currentQty = parseInt(container.querySelector(".qty-val").textContent);
            updateQuantity(productId, currentQty + 1);
            return;
          }

          const decBtn = e.target.closest(".qty-dec-btn");
          if (decBtn) {
            const container = decBtn.closest(".cart-control-container");
            const productId = container.getAttribute("data-product-id");
            const currentQty = parseInt(container.querySelector(".qty-val").textContent);
            if (currentQty <= 1) {
              removeFromCart(productId);
            } else {
              updateQuantity(productId, currentQty - 1);
            }
            return;
          }
        });
      });
    </script>
</body>

</html>
