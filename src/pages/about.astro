---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Story | Nutrivae Foods" currentPath="/about">
<main>

        <section class="page-hero">
            <div class="page-hero-inner">
                <span class="section-tag" data-animate="fade-up">About Nutrivae</span>
                <h1 data-animate="fade-up" data-delay="100">A simple <em>belief.</em></h1>
                <p data-animate="fade-up" data-delay="200">Everyday food should nourish the body honestly and naturally.
                    That's the belief Nutrivae was built on and everything we do flows from it.</p>
            </div>
            <div class="page-hero-blob"></div>
        </section>

        <section class="story-content-section">
            <div class="story-two-col" data-animate="fade-up">
                <div class="story-col-img">
                    <img src="assets/farm_field.png" alt="Our farm roots">
                </div>
                <div class="story-col-text">
                    <span class="section-tag">Our Roots</span>
                    <h2>Rooted in <em>agriculture.</em></h2>
                    <p>Nutrivae was born from a deep respect for the land and the people who work it. We believe food is
                        most powerful when it is closest to its natural form - minimally processed, honestly grown, and
                        thoughtfully brought to your table.</p>
                    <p>We work directly with farmers who share our values of quality, sustainability, and integrity.
                        Every ingredient is chosen with intention and purpose.</p>
                </div>
            </div>

            <div class="story-two-col reverse" data-animate="fade-up">
                <div class="story-col-img">
                    <img src="assets/ingredients_flat.png" alt="Our ingredients">
                </div>
                <div class="story-col-text">
                    <span class="section-tag">Our Science</span>
                    <h2>Guided by <em>nutrition science.</em></h2>
                    <p>We don't guess at nutrition. Every product is developed with input from nutrition science
                        understanding how plant-based proteins, fibers, and micronutrients work together to support a
                        healthy, active life.</p>
                    <p>From sourcing quality raw materials to modern processing, every step is designed to preserve
                        natural goodness and deliver reliable nutrition you can count on.</p>
                </div>
            </div>
        </section>

        <section class="story-values">
            <div class="story-val-card" data-animate="fade-up" data-delay="0">
                <div class="val-icon">🌱</div>
                <h3>Pure</h3>
                <p>No preservatives, no artificial additives. Just clean, wholesome ingredients the way nature made
                    them.</p>
            </div>
            <div class="story-val-card" data-animate="fade-up" data-delay="100">
                <div class="val-icon">🤝</div>
                <h3>Accessible</h3>
                <p>Great nutrition shouldn't be a luxury. We bring honest, affordable food to every household.</p>
            </div>
            <div class="story-val-card" data-animate="fade-up" data-delay="200">
                <div class="val-icon">⚡</div>
                <h3>Trustworthy</h3>
                <p>Consistent quality in every pack, every time. Nutrivae - Thoughtfully Grown, Carefully Crafted.</p>
            </div>
        </section>

        <section class="cta-banner">
            <div class="cta-banner-inner">
                <div class="cta-banner-text">
                    <span class="section-tag light">Simple Nutrition</span>
                    <h2>Ready to eat <em>better?</em></h2>
                    <p>Explore our clean, plant-based products crafted with honesty and care.</p>
                    <a href="products.html" class="btn-primary light">Explore Products</a>
                </div>
                <div class="cta-banner-img">
                    <img src="assets/hero_lifestyle.png" alt="Nutrivae Products">
                </div>
            </div>
        </section>

    </main>
</Layout>
