---
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../services/api";
import { FEATURES } from "../config";

const allProducts = await getProducts();
---

<Layout title="Products | Nutrivae Foods" currentPath="/products">
  <main style="padding-top: 100px;">
    <!-- Header Area -->
    <div style="max-width: 1300px; margin: 0 auto; padding: 20px;">
      <!-- Breadcrumbs -->
      <div style="font-size: 0.85rem; color: #666; margin-bottom: 20px;">
        <span>Home</span> &gt; <span>Shop</span> &gt; <span style="font-weight: 600; color: #333;">All Products</span>
      </div>
      
      <!-- Title & Filters -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1 style="margin: 0; font-size: 1.8rem; font-weight: 700;">All Products</h1>
        <div style="display: flex; gap: 10px; align-items: center;">
          <div style="position: relative;">
            <input type="text" id="search-input" placeholder="Search products..." style="padding: 8px 15px 8px 35px; border: 1px solid #ddd; border-radius: 20px; font-size: 0.9rem; outline: none; width: 200px; transition: all 0.2s;">
            <svg style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #888;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <div style="position: relative;">
            <button id="sort-btn" style="background: white; border: 1px solid #ddd; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 5px;">
              Sort <span>⇅</span>
            </button>
            <div id="sort-dropdown" class="sort-dropdown">
              <button class="sort-option active" data-sort="default">Default</button>
              <button class="sort-option" data-sort="price-asc">Price: Low to High</button>
              <button class="sort-option" data-sort="price-desc">Price: High to Low</button>
            </div>
          </div>
          <button id="filter-drawer-btn" style="background: white; border: 1px solid #ddd; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; gap: 5px;">
            All filters <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Products Layout -->
    <div class="products-layout" style="display: block;">
      <!-- Main Content -->
      <div class="products-main" style="max-width: 1300px; margin: 0 auto; padding: 0 20px;">

        <!-- Products Grid -->
        <div class="full-grid" id="products-grid">
          {
            allProducts.map((p, i) => (
              <div
                class="prod-item"
                data-animate="fade-up"
                data-delay={(i % 4) * 100}
                data-category={p.data.category}
                data-price={p.data.price}
                data-name={p.data.name.toLowerCase()}
              >
                <div class="prod-img">
                  <div class="prod-badge-row">
                    {p.data.isNew ? <span class="prod-label green">Bestseller</span> : null}
                  </div>
                  <a href={`/product/${p.data.id}`}>
                    <img
                      src={p.data.image}
                      alt={p.data.name}
                    />
                  </a>
                </div>
                <div class="prod-info" style="padding: 15px; display: flex; flex-direction: column; flex-grow: 1;">
                  <div style="flex-grow: 1;">
                    <h3 style="margin: 0 0 5px 0; font-size: 0.95rem; font-weight: 600; line-height: 1.3;">
                      <a href={`/product/${p.data.id}`} style="color: #333; text-decoration: none;">
                        {p.data.name}
                      </a>
                    </h3>
                    <p class="prod-sub" style="margin: 0 0 10px 0; color: #888; font-size: 0.8rem;">{p.data.subtitle || "1 Unit"}</p>
                    
                    <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 12px; font-size: 0.8rem;">
                      <span style="color: #00875A;">★★★★☆</span>
                      <span style="color: #00875A; font-weight: 600;">4.{Math.floor(Math.random() * 5) + 1}</span>
                      <span style="color: #888;">({Math.floor(Math.random() * 500) + 50})</span>
                    </div>
                  </div>
                  
                  <div class="prod-price-action" style="margin-top: auto;">
                    <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 15px;">
                      <span class="catalog-price" style="font-weight: 700; font-size: 1.1rem; color: #333;">₹{p.data.price}</span>
                      <span class="catalog-price-old" style="text-decoration: line-through; color: #888; font-size: 0.85rem;">₹{Math.floor(p.data.price * 1.25)}</span>
                      <span style="color: #00875A; font-size: 0.8rem; font-weight: 600;">22% off</span>
                    </div>

                    {p.data.variants && p.data.variants.length > 0 && (
                        <select class="catalog-variant-select" data-product-id={p.data.id} style="margin-bottom: 10px; padding: 5px; border-radius: 5px; border: 1px solid var(--border);">
                          {p.data.variants.map((v, vIdx) => (
                              <option value={v.size} data-price={v.price}>{v.size}</option>
                          ))}
                        </select>
                    )}
                    
                    {FEATURES.enableCartAndAuth ? (
                      <div class="cart-control-container" data-product-id={p.data.id} data-product-json={JSON.stringify(p.data)}>
                        <button class="add-init-btn">
                          ADD
                        </button>
                        <div class="qty-control">
                          <button class="qty-dec-btn qty-btn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                          </button>
                          <span class="qty-val">1</span>
                          <button class="qty-inc-btn qty-btn" style="font-size: 1.2rem; line-height: 1;">+</button>
                        </div>
                      </div>
                    ) : (
                      <a href={p.data.whatsappLink || `https://wa.me/919824664973?text=${encodeURIComponent("Hello Nutrivae,\nI'd like to order:\n" + p.data.name + " " + (p.data.variants && p.data.variants.length > 0 ? p.data.variants[0].size : "500g") + "\nQuantity: 1\nPlease help me place the order.")}`} target="_blank" class="buy-btn catalog-wa-btn" style="width: 100%; text-align: center; display: block; box-sizing: border-box; text-decoration: none; padding: 10px; background: var(--green); color: white; border-radius: 6px; font-weight: bold;">
                        Order on WhatsApp
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Pagination -->
        <div class="pagination" id="pagination-controls">
          <!-- JS generated -->
        </div>
      </div>
    </div>

    <!-- Promise Strip -->
    <div class="promise-strip" data-animate="fade-up">
      <div class="promise-inner">
        <div class="promise-item">
          <div class="p-icon">🌾</div>
          <h4>Farm Sourced</h4>
          <p>Directly from responsible Indian farmers</p>
        </div>
        <div class="promise-item">
          <div class="p-icon">🚫</div>
          <h4>No Preservatives</h4>
          <p>Clean label, nothing artificial</p>
        </div>
        <div class="promise-item">
          <div class="p-icon">💚</div>
          <h4>100% Vegetarian</h4>
          <p>Pure plant-based ingredients</p>
        </div>
        <div class="promise-item">
          <div class="p-icon">🛡</div>
          <h4>Quality Assured</h4>
          <p>Consistent nutrition, every batch</p>
        </div>
      </div>
    </div>

    <!-- Filter Drawer -->
    <div id="filter-drawer-overlay" class="filter-drawer-overlay"></div>
    <div id="filter-drawer" class="filter-drawer">
      <div class="filter-drawer-header">
        <h3 style="margin: 0; font-size: 1.2rem;">All Filters</h3>
        <button id="close-filter-drawer" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
      </div>
      <div class="filter-drawer-body">
        <div class="filter-group">
          <h4>Categories</h4>
          <button class="filter-btn active" data-filter="all">All Products</button>
          <button class="filter-btn" data-filter="daal">Daals</button>
          <button class="filter-btn" data-filter="grains">Grains</button>
          <button class="filter-btn" data-filter="seeds">Seeds</button>
          <button class="filter-btn" data-filter="nuts">Nuts</button>
          <button class="filter-btn" data-filter="flour">Flours</button>
          <button class="filter-btn" data-filter="spices">Spices</button>
        </div>
        <div class="filter-group">
          <h4>Size</h4>
          <div class="filter-list">
            <label><input type="checkbox" checked /> 500g</label>
            <label><input type="checkbox" checked /> 1kg</label>
            <label><input type="checkbox" checked /> 5kg</label>
          </div>
        </div>
      </div>
      <div style="padding: 20px; border-top: 1px solid #eee;">
        <button id="apply-filter-btn" style="width: 100%; padding: 12px; background: var(--green); color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">Show Results</button>
      </div>
    </div>

    <section class="cta-banner">
      <div class="cta-banner-inner">
        <div class="cta-banner-text">
          <span class="section-tag light">More Coming Soon</span>
          <h2>Growing our <em>range.</em></h2>
          <p>
            New clean-label products are in development. Contact us to stay in
            the loop or for bulk enquiries.
          </p>
          <a href="contact.html" class="btn-primary light">Get in Touch</a>
        </div>
        <div class="cta-banner-img">
          <img src="assets/ingredients_flat.png" alt="Nutrivae range" />
        </div>
      </div>
    </section>

    <!-- Journey Modal -->
    <div class="journey-modal-overlay" id="journey-modal">
      <div class="journey-modal-content">
        <button class="journey-modal-close" id="journey-modal-close"
          >&times;</button
        >
        <div class="journey-modal-body" data-lenis-prevent>
          <div class="journey-header">
            <span class="section-tag">Product Journey</span>
            <h2 id="journey-title">Product Name</h2>
            <p class="journey-meta">
              Farmer: <strong id="journey-farmer"></strong> &nbsp;&bull;&nbsp; Location:
              <a
                id="journey-location-link"
                href="#"
                target="_blank"
                style="color: var(--green); text-decoration: underline;"
                ><strong id="journey-location"></strong></a
              >
            </p>
          </div>
          <div class="timeline-container" id="journey-timeline">
            <div class="timeline-line"></div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Soil Preparation <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Rich, nutrient-dense soil prepared using natural methods.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Planting <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Sourced heirloom seeds planted with care and intention.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Harvesting <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>
                  Hand-picked at peak ripeness to ensure maximum flavor and
                  nutrition.
                </p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Processing <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Cleaned and naturally processed without harsh chemicals.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
            <div class="timeline-step">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h4>
                  Packaging <span
                    class="step-time"
                    style="font-size: 0.85em; font-weight: normal; color: var(--text-muted); float: right;"
                  ></span>
                </h4>
                <p>Sealed fresh in eco-conscious packaging for your pantry.</p>
                <div
                  class="step-gallery"
                  style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lightbox -->
    <div id="lightbox-overlay">
      <img id="lightbox-img" src="" alt="Expanded View" />
    </div>
  </main>
    <script is:inline>
      (function () {
        console.log("Init filter & pagination for products");
        const filterBtns = document.querySelectorAll(".filter-btn");
        const products = document.querySelectorAll(".prod-item");
        const paginationContainer = document.querySelector(".pagination");
        
        const sortBtn = document.getElementById("sort-btn");
        const sortDropdown = document.getElementById("sort-dropdown");
        const sortOptions = document.querySelectorAll(".sort-option");
        
        const filterDrawerBtn = document.getElementById("filter-drawer-btn");
        const filterDrawerOverlay = document.getElementById("filter-drawer-overlay");
        const filterDrawer = document.getElementById("filter-drawer");
        const closeFilterDrawer = document.getElementById("close-filter-drawer");
        const applyFilterBtn = document.getElementById("apply-filter-btn");

        let currentFilter = sessionStorage.getItem('products_currentFilter') || "all";
        let currentSort = sessionStorage.getItem('products_currentSort') || "default";
        let currentSearch = sessionStorage.getItem('products_currentSearch') || "";
        let currentPage = parseInt(sessionStorage.getItem('products_currentPage')) || 1;
        const itemsPerPage = 12;

        function saveState() {
          sessionStorage.setItem('products_currentFilter', currentFilter);
          sessionStorage.setItem('products_currentSort', currentSort);
          sessionStorage.setItem('products_currentSearch', currentSearch);
          sessionStorage.setItem('products_currentPage', currentPage);
        }
        let filteredItems = Array.from(products);

        // Sort Toggle
        if (sortBtn && sortDropdown) {
          sortBtn.addEventListener("click", () => {
            sortDropdown.classList.toggle("active");
          });
          
          document.addEventListener("click", (e) => {
            if (!sortBtn.contains(e.target) && !sortDropdown.contains(e.target)) {
              sortDropdown.classList.remove("active");
            }
          });
        }
        
        // Sort Selection
        if (sortOptions.length > 0) {
          sortOptions.forEach(opt => {
            opt.addEventListener("click", (e) => {
              sortOptions.forEach(o => o.classList.remove("active"));
              e.target.classList.add("active");
              currentSort = e.target.getAttribute("data-sort");
              sortDropdown.classList.remove("active");
              applyFilters(true);
            });
          });
        }
        
        // Filter Drawer Toggle
        function openDrawer() {
          if(filterDrawerOverlay) filterDrawerOverlay.classList.add("active");
          if(filterDrawer) filterDrawer.classList.add("active");
          document.body.style.overflow = "hidden";
        }
        
        function closeDrawer() {
          if(filterDrawerOverlay) filterDrawerOverlay.classList.remove("active");
          if(filterDrawer) filterDrawer.classList.remove("active");
          document.body.style.overflow = "";
        }

        if (filterDrawerBtn) filterDrawerBtn.addEventListener("click", openDrawer);
        if (closeFilterDrawer) closeFilterDrawer.addEventListener("click", closeDrawer);
        if (filterDrawerOverlay) filterDrawerOverlay.addEventListener("click", closeDrawer);
        if (applyFilterBtn) {
          applyFilterBtn.addEventListener("click", () => {
            closeDrawer();
          });
        }

        if (!paginationContainer) {
          console.error("Missing paginationContainer");
          return;
        }

        function renderPagination() {
          const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
          paginationContainer.innerHTML = "";

          if (totalPages <= 1) return;

          for (let i = 1; i <= totalPages; i++) {
            const btn = document.createElement("button");
            btn.className = "page-btn" + (i === currentPage ? " active" : "");
            btn.textContent = i;
            btn.style.margin = "0 5px";
            btn.addEventListener("click", () => {
              currentPage = i;
              saveState();
              updateView();
              const grid = document.querySelector(".full-grid");
              if (grid) {
                const offset =
                  grid.getBoundingClientRect().top + window.scrollY - 150;
                window.scrollTo({ top: offset, behavior: "smooth" });
              }
            });
            paginationContainer.appendChild(btn);
          }
        }

        function updateView() {
          // Hide all products first and reset order
          products.forEach((p) => {
            p.style.display = "none";
            p.style.order = "";
          });

          const start = (currentPage - 1) * itemsPerPage;
          const end = start + itemsPerPage;

          // Show only paginated items
          filteredItems.slice(start, end).forEach((p, index) => {
            p.style.display = "flex";
            p.style.order = index; // Apply visual order
            p.style.opacity = "1";
            p.style.transform = "none";
            p.style.animation = "none";
            p.offsetHeight; // force reflow
            p.classList.add("animated");
          });

          renderPagination();
        }

        function applyFilters(resetPage = true) {
          filteredItems = Array.from(products).filter((p) => {
            const cat = p.getAttribute("data-category") || "";
            const name = p.getAttribute("data-name") || "";
            const matchesCat = currentFilter === "all" || cat.includes(currentFilter);
            const matchesSearch = currentSearch === "" || name.includes(currentSearch);
            return matchesCat && matchesSearch;
          });
          
          if (currentSort === "price-asc") {
            filteredItems.sort((a, b) => parseFloat(a.getAttribute("data-price") || 0) - parseFloat(b.getAttribute("data-price") || 0));
          } else if (currentSort === "price-desc") {
            filteredItems.sort((a, b) => parseFloat(b.getAttribute("data-price") || 0) - parseFloat(a.getAttribute("data-price") || 0));
          }

          if (resetPage) currentPage = 1;
          saveState();
          updateView();
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            filterBtns.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            currentFilter = btn.getAttribute("data-filter");
            applyFilters(true);
          });
        });

        const searchInput = document.getElementById("search-input");
        if (searchInput) {
          searchInput.addEventListener("input", (e) => {
            currentSearch = e.target.value.toLowerCase();
            applyFilters(true);
          });
        }
        
        // Sync search input
        if (searchInput && currentSearch) {
          searchInput.value = currentSearch;
        }

        // Sync sort options
        sortOptions.forEach(opt => {
          if (opt.getAttribute("data-sort") === currentSort) {
            opt.classList.add("active");
          } else {
            opt.classList.remove("active");
          }
        });

        // Sync active state of filter buttons
        filterBtns.forEach((b) => {
          if (b.getAttribute("data-filter") === currentFilter) b.classList.add("active");
          else b.classList.remove("active");
        });
        
        // Run immediately
        applyFilters(false);
      })();

    // Journey Modal Functionality (Restored)
    (function () {
      const journeyModal = document.getElementById("journey-modal");
      const journeyClose = document.getElementById("journey-modal-close");

      const jTitle = document.getElementById("journey-title");
      const jFarmer = document.getElementById("journey-farmer");
      const jLocation = document.getElementById("journey-location");
      const jLocationLink = document.getElementById("journey-location-link");
      let timelineSteps = null;
      if (journeyModal) {
        timelineSteps = journeyModal.querySelectorAll(".timeline-step");
      }

      if (journeyModal && journeyClose) {
        // Use event delegation for dynamic buttons
        document.body.addEventListener("click", (e) => {
          const btn = e.target.closest(".btn-journey");
          if (!btn) return;

          const product = btn.getAttribute("data-product");
          const farmer = btn.getAttribute("data-farmer");
          const location = btn.getAttribute("data-location");
          const timesStr = btn.getAttribute("data-times") || "";
          const imagesStr = btn.getAttribute("data-images") || "";

          const times = timesStr.split("|");
          const images = imagesStr.split("|");

          if (product && jTitle) jTitle.textContent = product + " Journey";
          if (farmer && jFarmer) jFarmer.textContent = farmer;
          if (location && jLocation) {
            jLocation.textContent = location;
            if (jLocationLink)
              jLocationLink.href =
                "https://maps.google.com/?q=" + encodeURIComponent(location);
          }

          // Update timeline steps dynamically
          if (timelineSteps) {
            timelineSteps.forEach((step, index) => {
              const timeSpan = step.querySelector(".step-time");
              const gallery = step.querySelector(".step-gallery");

              // Time is required (if available in array)
              if (timeSpan) {
                timeSpan.textContent = times[index] ? times[index].trim() : "";
              }

              // Image is optional and can be multiple
              if (gallery) {
                gallery.innerHTML = ""; // Clear previous
                if (images[index] && images[index].trim() !== "") {
                  const stepImgs = images[index].split(",");
                  stepImgs.forEach((imgSrc) => {
                    if (!imgSrc.trim()) return;
                    const img = document.createElement("img");
                    img.src = imgSrc.trim();
                    // Responsive grid style for gallery items
                    img.style.width =
                      stepImgs.length > 1 ? "calc(50% - 5px)" : "100%";
                    img.style.maxHeight = "150px";
                    img.style.objectFit = "cover";
                    img.style.borderRadius = "8px";
                    img.style.cursor = "zoom-in";
                    img.style.transition = "transform 0.3s";
                    img.addEventListener(
                      "mouseover",
                      () => (img.style.transform = "scale(1.02)"),
                    );
                    img.addEventListener(
                      "mouseout",
                      () => (img.style.transform = "scale(1)"),
                    );

                    // Open Lightbox
                    img.addEventListener("click", () => {
                      const lbImg = document.getElementById("lightbox-img");
                      const lbOverlay =
                        document.getElementById("lightbox-overlay");
                      if (lbImg && lbOverlay) {
                        lbImg.src = img.src;
                        lbOverlay.classList.add("active");
                      }
                    });
                    gallery.appendChild(img);
                  });
                }
              }
            });
          }

          journeyModal.classList.add("active");
          document.body.style.overflow = "hidden"; // Prevent background scrolling
        });

        const lightboxOverlay = document.getElementById("lightbox-overlay");
        if (lightboxOverlay) {
          lightboxOverlay.addEventListener("click", () => {
            lightboxOverlay.classList.remove("active");
          });
        }

        journeyClose.addEventListener("click", () => {
          journeyModal.classList.remove("active");
          document.body.style.overflow = "";
        });

        journeyModal.addEventListener("click", (e) => {
          if (e.target === journeyModal) {
            journeyModal.classList.remove("active");
            document.body.style.overflow = "";
          }
        });
      }
    })();
    
    // Variant Selection Logic
    (function () {
      const variantSelects = document.querySelectorAll('.catalog-variant-select');
      variantSelects.forEach(select => {
          select.addEventListener('change', (e) => {
              const selectedOption = e.target.options[e.target.selectedIndex];
              const newPrice = Number(selectedOption.dataset.price);
              
              const prodItem = e.target.closest('.prod-item');
              if (prodItem) {
                  const priceDisplay = prodItem.querySelector('.catalog-price');
                  const oldPriceDisplay = prodItem.querySelector('.catalog-price-old');
                  const cartContainer = prodItem.querySelector('.cart-control-container');
                  
                  if (priceDisplay) priceDisplay.textContent = `₹${newPrice}`;
                  if (oldPriceDisplay) oldPriceDisplay.textContent = `₹${Math.floor(newPrice * 1.25)}`;
                  
                  if (cartContainer) {
                      const pData = JSON.parse(cartContainer.dataset.productJson);
                      pData.price = newPrice;
                      pData.size = selectedOption.value;
                      cartContainer.dataset.productJson = JSON.stringify(pData);
                      document.body.dispatchEvent(new CustomEvent('variant-changed'));
                  }
                  
                  const waBtn = prodItem.querySelector('.catalog-wa-btn');
                  if (waBtn) {
                      const pName = prodItem.querySelector('h3 a') ? prodItem.querySelector('h3 a').textContent.trim() : '';
                      const newWaUrl = `https://wa.me/919824664973?text=${encodeURIComponent("Hello Nutrivae,\nI'd like to order:\n" + pName + " " + selectedOption.value + "\nQuantity: 1\nPlease help me place the order.")}`;
                      waBtn.href = newWaUrl;
                  }
                  
                  // Update data-price on parent for filtering
                  prodItem.dataset.price = newPrice;
              }
          });
          // Initialize dataset
          select.dispatchEvent(new Event('change'));
      });
    })();
  </script>
</Layout>

