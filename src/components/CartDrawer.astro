---
// Cart Drawer Component
---
<div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
<div class="cart-drawer" id="cart-drawer">
    <div class="cart-header">
        <h3>Your Cart</h3>
        <button id="close-cart-btn" class="close-btn">&times;</button>
    </div>
    
    <div class="cart-items" id="cart-items-container">
        <!-- Cart items will be injected here via client-side JS -->
    </div>
    
    <div class="cart-footer">
        <div class="cart-total">
            <span>Total:</span>
            <span id="cart-total-price">₹0</span>
        </div>
        <button id="checkout-btn" class="btn-primary" style="width: 100%;">Checkout</button>
    </div>
</div>

<style>
    .cart-drawer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        opacity: 0;
        pointer-events: none;
        z-index: 9998;
        transition: opacity 0.3s ease;
    }
    
    .cart-drawer-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .cart-drawer {
        position: fixed;
        top: 0;
        right: -400px;
        width: 100%;
        max-width: 400px;
        height: 100vh;
        background: white;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        box-shadow: -5px 0 30px rgba(0,0,0,0.1);
        transition: right 0.3s ease;
    }

    .cart-drawer.active {
        right: 0;
    }

    .cart-header {
        padding: 20px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .cart-header h3 {
        margin: 0;
        font-family: var(--font-heading);
        font-size: 1.5rem;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 2rem;
        cursor: pointer;
        color: var(--text-muted);
    }

    .cart-items {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .cart-footer {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fdfbf7;
    }

    .cart-total {
        display: flex;
        justify-content: space-between;
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 20px;
    }

    /* Styles for injected cart items */
    :global(.cart-item) {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #f0f0f0;
    }
    :global(.cart-item img) {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 8px;
        margin-right: 15px;
    }
    :global(.cart-item-details) {
        flex: 1;
    }
    :global(.cart-item-title) {
        font-weight: 600;
        margin-bottom: 5px;
    }
    :global(.cart-item-price) {
        color: var(--green);
        font-weight: 500;
    }
    :global(.qty-controls) {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 5px;
    }
    :global(.qty-btn) {
        background: #eee;
        border: none;
        width: 25px;
        height: 25px;
        border-radius: 4px;
        cursor: pointer;
    }
</style>

<script>
    import { cartItems, getCartTotal, updateQuantity } from '../store/cartStore.js';

    // UI Elements
    const overlay = document.getElementById('cart-drawer-overlay');
    const drawer = document.getElementById('cart-drawer');
    const closeBtn = document.getElementById('close-cart-btn');
    const itemsContainer = document.getElementById('cart-items-container');
    const totalPriceEl = document.getElementById('cart-total-price');

    // Drawer Toggles (We will also add an event listener in the Header)
    function closeCart() {
        drawer.classList.remove('active');
        overlay.classList.remove('active');
    }
    
    closeBtn?.addEventListener('click', closeCart);
    overlay?.addEventListener('click', closeCart);
    
    // Listen for custom event to open cart
    window.addEventListener('open-cart', () => {
        drawer.classList.add('active');
        overlay.classList.add('active');
    });

    // Render Cart Items when store updates
    cartItems.subscribe((items) => {
        if (!itemsContainer) return;
        
        itemsContainer.innerHTML = '';
        const itemsArr = Object.values(items);
        
        if (itemsArr.length === 0) {
            itemsContainer.innerHTML = '<p style="text-align:center; color:gray; margin-top:40px;">Your cart is empty.</p>';
        } else {
            itemsArr.forEach(item => {
                const div = document.createElement('div');
                div.className = 'cart-item';
                div.innerHTML = `
                    <img src="/${item.image.replace(/^\/?/, '')}" alt="${item.name}">
                    <div class="cart-item-details">
                        <div class="cart-item-title">${item.name}</div>
                        <div class="cart-item-price">₹${item.price}</div>
                        <div class="qty-controls">
                            <button class="qty-btn minus" data-id="${item.id}">-</button>
                            <span>${item.quantity}</span>
                            <button class="qty-btn plus" data-id="${item.id}">+</button>
                        </div>
                    </div>
                `;
                itemsContainer.appendChild(div);
            });

            // Attach listeners to dynamically created buttons
            itemsContainer.querySelectorAll('.minus').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const id = e.target.dataset.id;
                    const qty = items[id].quantity - 1;
                    updateQuantity(id, qty);
                });
            });
            itemsContainer.querySelectorAll('.plus').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const id = e.target.dataset.id;
                    const qty = items[id].quantity + 1;
                    updateQuantity(id, qty);
                });
            });
        }
        
        // Update Total
        if(totalPriceEl) {
            totalPriceEl.textContent = `₹${getCartTotal()}`;
        }
    });
</script>
